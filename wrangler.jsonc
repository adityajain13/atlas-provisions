{
  "name": "atlas-provisions",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-provisions",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Sign-in codes via Email Routing (free plan), unless RESEND_API_KEY is set. Email Routing only
  // delivers to verified destination addresses, so an address that signs in must be one (see README).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "DEV": "0",
    "PLANNER_MODEL": "claude-sonnet-5-5",
    // Sender for sign-in mail. Suggested address; it may need adding in Email Routing (see README).
    "MAIL_FROM": "provisions@adityajain.ca"
  },
  // Secrets (set with `npx wrangler secret put NAME`, or in the Cloudflare dashboard):
  //   ALLOWED_EMAILS     optional fallback: comma-separated emails approved to sign in. Access is managed
  //                      in Household > App access.
  //   ADMIN_EMAILS       optional: comma-separated admins who manage App access. Unset: the owners of household h1.
  //   ANTHROPIC_API_KEY  Claude API key (planner, receipts)
  //   RESEND_API_KEY     optional: sign-in mail via Resend (domain adityajain.ca verified there). Also sends invites.
  // Monthly caps per household (whole numbers; default 20 plans, 30 receipt scans, 30 prep refreshes). Set as
  // vars or secrets: PLAN_CAP_MONTHLY, RECEIPT_CAP_MONTHLY, PREP_CAP_MONTHLY.
  // Hourly on Sundays (UTC). Each run refreshes the flyers of one postal code that is stale this week.
  "triggers": { "crons": ["0 * * * SUN"] },
  "routes": [{ "pattern": "adityajain.ca/provisions*", "zone_name": "adityajain.ca" }]
}
